# Example environment variables for money-bot
# Copy to .env and fill values before running the container

# Telegram bot token
BOT_TOKEN=your-telegram-bot-token

# Admin Telegram user id (numeric)
ADMIN_ID=123456789

# Maximum history items to keep per currency
HISTORY_MAX_LEN=5

# Comma-separated list of currency ISO codes used by the bot
# Example: CURRENCY_LIST=USD,CNY
CURRENCY_LIST=USD,CNY

# Path inside container where store/history files are kept
STORE_PATH=/usr/src/app/history

# Interval to update currency data (seconds)
UPDATE_CURRENCY_INTERVAL_SEC=3600

# Log file name (kept in the project root, rotated at 5MB), optional
LOG_FILE_NAME=bot.log

# SMTP / email settings (optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=bot@example.com
EMAIL_PASS=replace-with-password
EMAIL_RECIPIENT=recipient@example.com
